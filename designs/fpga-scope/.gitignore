# Verilator / simulation build artifacts
obj_dir/
sim/build/
*.o
*.a
*.d

# Waveforms & sim logs
*.vcd
*.fst
*.fst.hier
*.wlf
build.log
*.log

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
.venv/

# Generated golden-reference vectors (regenerated by sim/model/scope_ref.py from run.sh)
sim/build/**/*.mem

# Editor / OS junk
*~
*.swp
.DS_Store
*:Zone.Identifier

# FPGA build artifacts (fpga/<board>). Source deliverables stay tracked; everything
# below is regenerated by the vendor flow.
fpga/**/output_files/
fpga/**/db/
fpga/**/incremental_db/
fpga/**/qdb/
fpga/**/dni/
fpga/**/tmp-clearbox/
*.qws
*.sof
*.pin
*.jdi
*.sld
*.smsg
*.rpt

# SymbiYosys proof working directories (regenerated by `sby -f formal/*.sby`)
formal/*/

# Quartus build artifacts (fpga/axc3000 board build, #12)
fpga/**/output_files/
fpga/**/db/
fpga/**/incremental_db/
fpga/**/qdb/
fpga/**/dni/
fpga/**/.qsys_edit/
fpga/**/*.qws
fpga/**/*.rpt
fpga/**/*.summary
fpga/**/*.jdi
fpga/**/*.pin
fpga/**/*.sld
fpga/**/*.sof
fpga/**/*.pof
fpga/axc3000/scope_dump.txt

# checked-in hardware capture deliverables (#12) â€” exempt from *.vcd above
!docs/captures/
!docs/captures/*.vcd

# AMD Vivado flow (fpga/xilinx): scratch is ignored; the reports + logs the README cites are
# committed deliverables — exempt from *.rpt / *.log above
fpga/xilinx/build/
!fpga/xilinx/reports/
!fpga/xilinx/reports/**
# xsim regression (sim/run_xsim.ps1): scratch ignored, per-TB logs committed
xsim.dir/
*.pb
*.jou
*.wdb
!sim/xsim_*.log
!sim/verilator_run.log
